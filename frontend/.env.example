# Copy to .env.local (already gitignored via *.local) to point the
# dashboard at a running backend instead of the bundled fixtures.

# "mock" (default) uses frontend/src/data/fixtures/*.json.
# "api" makes real HTTP calls -- see src/data/client.ts.
VITE_DATA_MODE=mock

# Backend base URL (api/main.py). Default matches `uvicorn api.main:app`'s
# default port.
VITE_API_BASE_URL=http://localhost:8000

# Must match the backend's API_KEY (see ../.env.example at repo root).
VITE_API_KEY=changeme

# Supabase Auth (optional -- "Sign in with Google" in the header). Leave
# both unset to disable the sign-in button entirely rather than crash.
# Find these under Project Settings -> API in the Supabase dashboard --
# the project URL and the publishable/anon key, never the secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
