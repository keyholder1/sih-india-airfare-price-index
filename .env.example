# Copy this file to .env and fill in real values locally.
# NEVER commit a real .env file -- it is gitignored, keep it that way.

# ──────────────────────────────────────────────
# Backend API (api/main.py)
# ──────────────────────────────────────────────

# Shared API key for hackathon-grade authentication.
# Every request to /api/v1/* must include this value
# in the X-API-Key header.
API_KEY=changeme

# Allowed frontend origin for CORS.
# Set this to your dashboard's URL in production.
FRONTEND_ORIGIN=http://localhost:3000

# ──────────────────────────────────────────────
# Scraper credentials (src/scraper/*) -- see docs/scraper.md
# "Credential handling". The scraper reads these via os.environ.
# ──────────────────────────────────────────────

# --- IndiGo (src/scraper/indigo_source.py) ---
# Required for the IndiGo adapter to attempt anything beyond SOURCE_UNAVAILABLE.
# Currently the adapter will still return SOURCE_UNAVAILABLE even with these
# set, until IndiGoSource._call_api is implemented against a verified API
# contract -- see that file's docstring.
INDIGO_API_KEY=
INDIGO_USERNAME=
INDIGO_PASSWORD=
INDIGO_API_BASE_URL=

# --- SerpApi Google Flights (src/scraper/serpapi_source.py) ---
# Real, working source once this is set -- get a key from serpapi.com.
# Check your account's plan/credit limits before running large batches.
SERPAPI_API_KEY=

# --- News & event context (src/index_engine/newsdata_news_provider.py) ---
# Real news source for GET /api/v1/routes/{route}/context -- get a free
# key from newsdata.io. Comma-separate multiple keys to rotate to the
# next one automatically when one hits its quota (see that module's
# NewsdataNewsProvider docstring). Falls back to GDELT (free, keyless,
# but not reachable from every network) if unset, or to MockNewsProvider
# if NEWS_PROVIDER=mock.
NEWSDATA_API_KEY=
# NEWS_PROVIDER=mock

# --- Placeholders for future adapters (not yet implemented) ---
# CLEARTRIP_API_KEY=
# CLEARTRIP_ORIGIN=
# CLEARTRIP_CLIENT_ID=
# CLEARTRIP_CLIENT_SECRET=
# DUFFEL_API_KEY=
# TRAVELPAYOUTS_API_TOKEN=
