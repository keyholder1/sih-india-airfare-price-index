# ──────────────────────────────────────────────
# sih-backend environment configuration
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────

# Shared API key for hackathon-grade authentication.
# Every request to /api/v1/* must include this value
# in the X-API-Key header.
API_KEY=changeme

# Allowed frontend origin for CORS.
# Set this to your dashboard's URL in production.
FRONTEND_ORIGIN=http://localhost:3000
