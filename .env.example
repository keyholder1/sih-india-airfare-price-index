# Copy this file to .env and fill in real values locally.
# NEVER commit a real .env file -- it is gitignored, keep it that way.

# ──────────────────────────────────────────────
# Backend API (api/main.py)
# ──────────────────────────────────────────────

# Shared API key for hackathon-grade authentication.
# Every request to /api/v1/* must include this value
# in the X-API-Key header.
API_KEY=changeme

# Allowed frontend origin for CORS.
# Set this to your dashboard's URL in production.
FRONTEND_ORIGIN=http://localhost:3000

# ──────────────────────────────────────────────
# Database (src/engine/db.py)
# ──────────────────────────────────────────────

# Postgres connection string. If unset, the app falls back to the flat
# file trees under data/, then to a synthetic demo dataset -- never
# crashes over a missing database (see data_access.py). Local dev via
# Docker: docker run -d --name sih_airfare_db -e POSTGRES_USER=sih
#   -e POSTGRES_PASSWORD=<yours> -e POSTGRES_DB=airfare_index
#   -p 5555:5432 postgres:16-alpine
# then: python migrate_flat_files_to_postgres.py (one-off, idempotent).
#
# Deploying on Supabase: use the POOLED connection string (Supavisor,
# transaction mode, port 6543), not the direct one (port 5432) -- every
# call in db.py opens and closes its own connection with no pooling of
# its own, and a burst of concurrent serverless invocations can exhaust
# Supabase's direct-connection limit fast. Find both under
# Project Settings -> Database in the Supabase dashboard; use the direct
# string only for one-off local scripts like migrate_flat_files_to_postgres.py.
DATABASE_URL=

# ──────────────────────────────────────────────
# Scraper credentials (src/scraper/*) -- see docs/scraper.md
# "Credential handling". The scraper reads these via os.environ.
# ──────────────────────────────────────────────

# --- IndiGo (src/scraper/indigo_source.py) ---
# Required for the IndiGo adapter to attempt anything beyond SOURCE_UNAVAILABLE.
# Currently the adapter will still return SOURCE_UNAVAILABLE even with these
# set, until IndiGoSource._call_api is implemented against a verified API
# contract -- see that file's docstring.
INDIGO_API_KEY=
INDIGO_USERNAME=
INDIGO_PASSWORD=
INDIGO_API_BASE_URL=

# --- SerpApi Google Flights (src/scraper/serpapi_source.py) ---
# Real, working source once this is set -- get a key from serpapi.com.
# Check your account's plan/credit limits before running large batches.
SERPAPI_API_KEY=

# --- News & event context (src/index_engine/*_news_provider.py) ---
# Real news sources for GET /api/v1/routes/{route}/context -- every one
# of these that's set is queried together (src/index_engine/
# composite_news_provider.py); relevance ranking (news_matching.py) is
# the only thing deciding which articles surface, not which key found
# them. Results are cached in Postgres for one calendar week per route
# (src/engine/news_cache_provider.py) so looking at the same route
# repeatedly doesn't re-spend any key's quota. Falls back to GDELT (free,
# keyless, but not reachable from every network) if none of these are
# set, or to MockNewsProvider if NEWS_PROVIDER=mock.
# newsdata.io -- comma-separate multiple keys to rotate to the next one
# automatically when one hits its quota (see NewsdataNewsProvider docstring).
NEWSDATA_API_KEY=
# newsapi.org
NEWSAPI_ORG_API_KEY=
# Event Registry / newsapi.ai
EVENTREGISTRY_API_KEY=
# NEWS_PROVIDER=mock

# --- Natural event context (src/index_engine/eonet_*.py, see docs/eonet_context.md) ---
# NASA EONET's public REST API (https://eonet.gsfc.nasa.gov/api/v3) is
# genuinely keyless -- verified live 2026-09-04, no credential of any
# kind is required or sent by default. EONET_API_KEY exists only for
# forward-compatibility (appended as a harmless, currently-unused
# `api_key` query param if NASA ever gates these endpoints) and per this
# project's security policy of reading every credential from the
# environment, never hard-coding one. Leave blank unless you have a
# specific reason to set it.
EONET_API_KEY=
# EONET_BASE_URL=https://eonet.gsfc.nasa.gov/api/v3

# --- Current-conditions context (src/index_engine/openweather_client.py) ---
# Unlike EONET, this genuinely requires a key -- get a free one from
# https://home.openweathermap.org/api_keys. New keys can take up to ~2
# hours to activate (OpenWeatherMap's own documented behaviour) -- a 401
# from a brand-new key isn't necessarily invalid. Unset/invalid degrades
# this one context source to "unavailable"; never breaks the index,
# analytics, or the rest of the dashboard.
OPENWEATHER_API_KEY=
# OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# --- Placeholders for future adapters (not yet implemented) ---
# CLEARTRIP_API_KEY=
# CLEARTRIP_ORIGIN=
# CLEARTRIP_CLIENT_ID=
# CLEARTRIP_CLIENT_SECRET=
# DUFFEL_API_KEY=
# TRAVELPAYOUTS_API_TOKEN=
